{
  "manifest_version": 3,
  "name": "OviPets Friend Sweep Lite",
  "version": "0.2.0",
  "description": "Minimal low-resource OviPets friend egg sweep. Name the Species: built-in silhouettes plus the ones it learns, a safety pause and a review page.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://ovipets.com/*",
    "https://app.ovipets.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ovipets.com/*",
        "https://app.ovipets.com/*"
      ],
      "js": [
        "data/species-static.js",
        "domain/species-shape.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
